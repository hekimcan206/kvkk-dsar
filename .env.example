# Copy to .env to override the compose defaults. Every default is a local-development value only.
POSTGRES_PASSWORD=postgres-dev-only
MIGRATOR_PASSWORD=migrator-dev-only
APP_PASSWORD=app-dev-only
CLINIC_OWNER_PASSWORD=owner-dev-only
FINDER_PASSWORD=finder-dev-only
ERASER_PASSWORD=eraser-dev-only
POSTGRES_PORT=58761
API_PORT=58762
SEED_PEOPLE=2000
# Base64 keys (32 bytes each). Generate real ones with: openssl rand -base64 32
DSAR_FINGERPRINT_KEY=ZGV2LW9ubHkgZmluZ2VycHJpbnQga2V5IDMyYnl0ZXM=
DSAR_OTP_PEPPER=ZGV2LW9ubHkgb3RwIHBlcHBlciBrZXksIDMyIGJ5dGU=
DSAR_SUBJECT_KEY=ZGV2LW9ubHkgc3ViamVjdCBzZWFsIGtleSAzMiBieXQ=
# Evidence signing key (PKCS#8 PEM, ECDSA P-256). Empty: ephemeral per process, development only.
EVIDENCE_SIGNING_KEY_PEM=
# Optional: OTLP endpoint, e.g. http://aspire-dashboard:18889 with `--profile observability`.
OTEL_EXPORTER_OTLP_ENDPOINT=
